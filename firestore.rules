rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function role(r){ return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == r; }

    match /accountRequests/{id} {
      allow create: if true;
      allow read, update, delete: if role('admin');
    }
    match /groupRequests/{id} {
      allow create: if true;
      allow read, update, delete: if role('admin');
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || role('admin'));
      allow create, update, delete: if role('admin');
    }
    match /teacherAssignments/{id} {
      allow read: if role('admin') || (signedIn() && resource.data.teacherUid == request.auth.uid);
      allow create, update, delete: if role('admin');
    }
    match /exams/{id} {
      allow read: if signedIn();
      allow create, update, delete: if role('admin');
    }
    match /marks/{id} {
      allow read: if signedIn();
      allow create, update: if role('admin') || (signedIn() && request.resource.data.teacherUid == request.auth.uid);
    }
    match /studyResources/{id} {
      allow read: if signedIn();
      allow create, update, delete: if role('admin') || (signedIn() && request.resource.data.teacherUid == request.auth.uid);
    }
    match /groupPoints/{id} {
      allow read: if signedIn();
      allow create, update, delete: if role('admin');
    }
  }
}